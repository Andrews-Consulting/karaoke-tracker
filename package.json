{
  "name": "mic-jaunt",
  "version": "1.0.65",
  "private": true,
  "description": "Mic Jaunt: a personal, local-only karaoke tracker PWA. No build step, no runtime dependencies.",
  "type": "module",
  "scripts": {
    "serve": "node tools/serve.js",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "node tools/screenshots.js",
    "check-version": "node tools/check-version.js",
    "bump": "node tools/bump-version.js",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "vitest": "^5.1.0"
  }
}
